# Execute dentro de backend/. Formato Java Properties: sem export e sem aspas.
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/controle_financeiro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# SMTP necessario para enviar e-mails de recuperacao de senha.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Obrigatorio: chave aleatoria com pelo menos 32 bytes.
JWT_SECRET=
# Duracao dos tokens em milissegundos (access: 1 hora; refresh: maximo de 2 horas).
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=7200000
# Para local HTTP, mantenha false/Lax. Em deploy HTTPS entre dominios, use true/None.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Optional: Gemini financial insights. Obtain a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
